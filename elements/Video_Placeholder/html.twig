{%- set c = content.content -%}
{%- set source = c.source|default('html5') -%}
{%- set file = c.video_file -%}
{%- set fileUrl = file is iterable ? file.url : file -%}
{%- set rawUrl = (source == 'html5' ? fileUrl : c.video_url)|trim -%}
{%- set img = c.image -%}
{%- set imgUrl = img is iterable ? img.url : img -%}
{%- set full = img is iterable ? img.sizes.full : null -%}
<div class="pdk-vp">
{%- if imgUrl %}
  <img class="pdk-vp__img" src="{{ imgUrl|e('html_attr') }}" alt="{{ (img.id ? get_attachment_alt(img.id) : img.alt)|e('html_attr') }}" loading="lazy" decoding="async"
    {%- if full.width and full.height %} width="{{ full.width|e('html_attr') }}" height="{{ full.height|e('html_attr') }}"{% endif -%}
    {%- if img.attributes.srcset %} srcset="{{ img.attributes.srcset|e('html_attr') }}"{% endif -%}
    {%- if img.attributes.sizes %} sizes="{{ img.attributes.sizes|e('html_attr') }}"{% endif -%}
  >
{%- endif %}
{%- if rawUrl or isBuilder %}
  <button type="button" class="pdk-vp__btn" aria-label="{{ c.label|default('Video afspelen')|e('html_attr') }}" data-type="{{ source|e('html_attr') }}" data-src="{{ rawUrl|e('html_attr') }}" data-loop="{{ c.loop ? 1 : 0 }}" data-muted="{{ c.muted ? 1 : 0 }}" data-controls="{{ c.controls ? 1 : 0 }}" data-inline="{{ c.plays_inline ? 1 : 0 }}">
    <span class="pdk-vp__icon" aria-hidden="true">
      {%- if c.icon.svgCode -%}
        {{ c.icon.svgCode }}
      {%- else -%}
        <svg viewBox="3.56 3.98 16.04 16.04" focusable="false"><path d="M8 5v14l11-7z"/></svg>
      {%- endif -%}
    </span>
  </button>
{%- endif %}
</div>
